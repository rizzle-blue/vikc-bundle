# Copy to .env (git-ignored). Used by the crawler (`pnpm crawl`) and the DB scripts
# (`node scripts/db-apply.mjs`). Secrets never go into git, chat or docs.

# Project URL, e.g. https://<project-ref>.supabase.co   (quote it or not, both work)
SUPABASE_URL=

# Management API personal access token (`sbp_…`) — lets scripts/db-apply.mjs run migrations.
# Get one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# The project's SECRET key (`sb_secret_…`): crawler writes, admin scripts.
# NOTE: the Management API masks this value unless you ask for it with ?reveal=true —
# a key that does not start with sb_secret_ will be rejected with 401 "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=

# The project's PUBLISHABLE key (`sb_publishable_…`): the only key the browser may see.
# Goes to Vercel as NEXT_PUBLIC_SUPABASE_ANON_KEY for apps/web.
SUPABASE_PUBLISHABLE_KEY=
