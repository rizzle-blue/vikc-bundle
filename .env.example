# Copy to .env (git-ignored). Two audiences:
#   * the app      → NEXT_PUBLIC_*  (publishable key, safe in the browser)
#   * the scripts  → SUPABASE_URL / SUPABASE_ACCESS_TOKEN (migrations, seeds)

# ---- app (also set these two in Vercel) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…

# ---- access codes (server-only; set the same two in Vercel) ----
# Shared codes, not accounts: the member code opens /enroll, the admin code opens /admin.
# Changing them requires a redeploy (the middleware compares them at build time).
MEMBER_ACCESS_CODE=
ADMIN_ACCESS_CODE=

# Server-only: used by /api/admin/* to write the programme. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- scripts ----
SUPABASE_URL=https://<project-ref>.supabase.co
# Management API personal access token (`sbp_…`) — lets scripts/db-apply.mjs run migrations
SUPABASE_ACCESS_TOKEN=
# (`SUPABASE_SERVICE_ROLE_KEY` is declared above — it is used by both the app and the scripts.)
