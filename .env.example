# Copy to .env (git-ignored). Two audiences:
#   * the app      → NEXT_PUBLIC_*  (publishable key, safe in the browser)
#   * the scripts  → SUPABASE_URL / SUPABASE_ACCESS_TOKEN (migrations, seeds)

# ---- app (also set these two in Vercel) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…

# ---- scripts ----
SUPABASE_URL=https://<project-ref>.supabase.co
# Management API personal access token (`sbp_…`) — lets scripts/db-apply.mjs run migrations
SUPABASE_ACCESS_TOKEN=
# the project's SECRET key (`sb_secret_…`): only for server-side scripts, never the browser.
# NOTE: the Management API masks this value unless requested with ?reveal=true.
SUPABASE_SERVICE_ROLE_KEY=
