# Copy to .env (git-ignored) — used by the crawler when you trigger a run
# (`pnpm crawl` / `./scripts/crawl.sh run`).
# Without a usable secret key the crawler stores fares in the local embedded Postgres
# (data/fares) instead of Supabase — nothing fails, it just stays local.

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# MUST be the project's SECRET key (sb_secret_… / service_role). Used for writes by the crawler.
# A publishable key (sb_publishable_…) is rejected: 401 "Secret API key required".
# Keep this out of git, logs and chat — the file is git-ignored.
SUPABASE_SERVICE_ROLE_KEY=

# Not needed here: the publishable/anon key belongs in Vercel for the web app (T3)
# as NEXT_PUBLIC_SUPABASE_ANON_KEY.
